{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@statefabric/core": ["packages/core/src/index.ts"],
      "@statefabric/sdk": ["packages/sdk/src/index.ts"],
      "@statefabric/persistence-s3": ["packages/persistence-s3/src/index.ts"],
      "@statefabric/persistence-local": ["packages/persistence-local/src/index.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  }
}
